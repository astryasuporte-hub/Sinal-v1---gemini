+  if (!database || !/^[a-zA-Z0-9_-]+$/.test(database)) {
+    throw new Error(`INVALID_DATABASE: Nome de banco de dados inválido ou corrompido: "${database}". O nome padrão da Supabase é "postgres".`);
+  }
+
+  return { host, port, user, password, database };
